{
  "db_name": "PostgreSQL",
  "query": "\n        SELECT n.id, n.ap_id, a.ap_id AS actor_ap_id,\n               n.tags as \"tags: Json<JsonValue>\"\n        FROM note n\n        JOIN actor a ON a.id = n.actor_id\n        WHERE n.is_local = FALSE\n          AND jsonb_typeof(n.tags) = 'array'\n          AND n.tags <> '[]'::jsonb\n          AND ($1::BIGINT IS NULL OR n.id > $1)\n        ORDER BY n.id ASC\n        LIMIT $2\n        ",
