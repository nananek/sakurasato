  "db_name": "PostgreSQL",
  "query": "\n        SELECT f.id AS \"follow_id!\", f.follower_actor_id AS \"follower_actor_id!\"\n        FROM follow f\n        JOIN actor a ON a.id = f.follower_actor_id\n        WHERE f.followed_actor_id = $1\n          AND f.state = 'accepted'\n          AND a.is_local = true\n        ",
