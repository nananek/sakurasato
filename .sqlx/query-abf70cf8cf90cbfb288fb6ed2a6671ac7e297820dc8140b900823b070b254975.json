  "query": "\n        SELECT\n            note_id as \"note_id!\",\n            COUNT(*) as \"count!\",\n            BOOL_OR(actor_id = $2) as \"viewer_renoted!\"\n        FROM announce\n        WHERE note_id = ANY($1)\n        GROUP BY note_id\n        ORDER BY note_id\n        ",
