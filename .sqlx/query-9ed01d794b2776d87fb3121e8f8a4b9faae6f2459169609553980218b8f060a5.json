{
  "db_name": "PostgreSQL",
  "query": "\n        SELECT\n            id, recipient_actor_id, event_type, notifier_actor_id, note_id, reaction,\n            is_read, created_at\n        FROM notification\n        WHERE recipient_actor_id = $1\n          AND ($2::bigint IS NULL OR id > $2)\n          AND ($3::bigint IS NULL OR id < $3)\n        ORDER BY id DESC\n        LIMIT $4\n        ",
