  "query": "\n        INSERT INTO domain_moderation (host, severity, reason)\n        VALUES ($1, $2, $3)\n        ON CONFLICT (host) DO UPDATE\n            SET severity = EXCLUDED.severity,\n                reason = EXCLUDED.reason,\n                updated_at = now()\n        RETURNING id, host, severity, reason, created_at, updated_at\n        ",
