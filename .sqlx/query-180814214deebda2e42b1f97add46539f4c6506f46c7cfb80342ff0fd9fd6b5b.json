{
  "db_name": "PostgreSQL",
  "query": "\n        SELECT a.host AS \"host!\", count(*) AS \"actor_count!\", dm.severity AS \"severity?\"\n        FROM actor a\n        LEFT JOIN domain_moderation dm ON dm.host = a.host\n        WHERE a.is_local = FALSE\n        GROUP BY a.host, dm.severity\n        ORDER BY count(*) DESC, a.host ASC\n        ",
