  "query": "\n        INSERT INTO announce (ap_id, note_id, actor_id, published_at)\n        VALUES ($1, $2, $3, $4)\n        ON CONFLICT (note_id, actor_id) DO UPDATE\n            SET published_at = announce.published_at\n        RETURNING id, ap_id, note_id, actor_id, published_at, created_at\n        ",
