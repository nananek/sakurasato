  "query": "\n        SELECT\n            content as \"content!\",\n            COUNT(*) as \"count!\",\n            MAX(emoji_id) as \"any_emoji_id: i64\"\n        FROM reaction\n        WHERE note_id = $1\n        GROUP BY content\n        ORDER BY MIN(created_at)\n        ",
