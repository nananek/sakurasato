  "query": "\n        SELECT\n            t.id, t.name, t.token_hash,\n            t.permissions as \"permissions: Json<Vec<String>>\",\n            t.last_used_at, t.created_at\n        FROM miauth_token t\n        JOIN miauth_session s ON s.issued_token_id = t.id\n        WHERE s.uuid = $1\n        ",
